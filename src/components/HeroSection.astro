---
import Container from "./Container.astro";
import { Image, Picture } from "astro:assets";
import logo from "../images/logo.png";
import Starfield from "./Starfield.astro";

// Small seeded PRNG so the photo shuffle is deterministic across builds/loads.
function mulberry32(seed) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "../images/photos2025/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);
const photos = Object.entries(photoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, module]) => ({ image: module.default }));

// Deterministic Fisher-Yates shuffle (fixed seed).
const rand = mulberry32(20251122);
for (let i = photos.length - 1; i > 0; i--) {
  const j = Math.floor(rand() * (i + 1));
  [photos[i], photos[j]] = [photos[j], photos[i]];
}

// Keep a constant px/s at the medium band height so the band's
// motion scales proportionally with its height across breakpoints.
const MD_BAND_HEIGHT = 171;
const PX_PER_SECOND = 100;
const copyWidth = photos.reduce(
  (sum, photo) =>
    sum + (MD_BAND_HEIGHT * photo.image.width) / photo.image.height,
  0
);
const marqueeDuration = Math.max(45, Math.round(copyWidth / PX_PER_SECOND * 1.5));
